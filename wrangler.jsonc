{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brobot-local",
  "main": "./src/worker/index.ts",
  // An die unterstützte workerd-Version gebunden; nur zusammen mit einem
  // Wrangler-/Miniflare-Update auf ein neueres Datum anheben.
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
  },
  "durable_objects": {
    "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelObject"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brobot-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "APP_ENV": "local",
    "ALLOWED_CHANNEL_LOGINS": "beispielkanal",
    "TIMEZONE": "Europe/Berlin"
  },
  "secrets": {
    "required": [
      "TWITCH_CLIENT_ID",
      "TWITCH_CLIENT_SECRET",
      "TWITCH_EVENTSUB_SECRET",
      "PUBLIC_ORIGIN",
      "SESSION_COOKIE_KEYS",
      "SESSION_ENCRYPTION_KEYS",
      "OVERLAY_TOKEN_PEPPER"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "brobot-staging",
      "main": "./src/worker/index.ts",
      "compatibility_date": "2026-09-04",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
      },
      "durable_objects": {
        "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brobot-staging",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "ALLOWED_CHANNEL_LOGINS": "beispielkanal",
        "TIMEZONE": "Europe/Berlin"
      },
      "secrets": {
        "required": [
          "TWITCH_CLIENT_ID",
          "TWITCH_CLIENT_SECRET",
          "TWITCH_EVENTSUB_SECRET",
          "PUBLIC_ORIGIN",
          "SESSION_COOKIE_KEYS",
          "SESSION_ENCRYPTION_KEYS",
          "OVERLAY_TOKEN_PEPPER"
        ]
      },
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 }
      }
    },
    "production": {
      "name": "brobot",
      "main": "./src/worker/index.ts",
      "compatibility_date": "2026-09-04",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "preview_urls": false,
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/auth/*", "/ws/*", "/healthz"]
      },
      "durable_objects": {
        "bindings": [{ "name": "CHANNEL", "class_name": "ChannelObject" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brobot-production",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "vars": {
        "APP_ENV": "production",
        "ALLOWED_CHANNEL_LOGINS": "beispielkanal",
        "TIMEZONE": "Europe/Berlin"
      },
      "secrets": {
        "required": [
          "TWITCH_CLIENT_ID",
          "TWITCH_CLIENT_SECRET",
          "TWITCH_EVENTSUB_SECRET",
          "PUBLIC_ORIGIN",
          "SESSION_COOKIE_KEYS",
          "SESSION_ENCRYPTION_KEYS",
          "OVERLAY_TOKEN_PEPPER"
        ]
      },
      "observability": {
        "enabled": true,
        "logs": { "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 0.01 }
      }
    }
  }
}
